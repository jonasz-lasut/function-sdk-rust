{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the crossplane/crossplane release the vendored run_function.proto was copied from",
      "managerFilePatterns": ["/^sdk/proto/v1/run_function\\.proto$/"],
      "matchStrings": [
        "Vendored from crossplane/crossplane (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\."
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "crossplane/crossplane"
    }
  ]
}
